# MIRA Frontend — Environment Template
#
# Copy this file to `.env.local` and adjust. `.env.local` is git-ignored, so
# personal overrides never reach the repository.

# ---------------------------------------------------------------------------
# API base URL
# ---------------------------------------------------------------------------
# FastAPI backend origin. Only the protocol + host + port (no trailing path).
VITE_API_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Mock data (development only)
# ---------------------------------------------------------------------------
# When "true", the dev server serves realistic fixture data on its OWN origin
# under `/api`, so the app runs end to end with no Python process. Because the
# request is same-origin, the browser never makes a cross-origin call, so CORS
# is never a factor.
#
# Set to "false" (the default) to point the app at a real backend via
# VITE_API_URL above.
#
# The mock layer lives in a Vite plugin with `apply: 'serve'`, so it cannot
# exist in a production build. `npm run build` also runs
# `scripts/verify-no-mocks.mjs`, which fails the build if any mock marker
# reaches `dist/`.
VITE_USE_MOCK=false
